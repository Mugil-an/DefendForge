{
  "name": "juice-shop",
  "service": "juice_shop",
  "base_url": "http://localhost:3000",
  "health": {
    "path": "/rest/admin/application-version"
  },
  "discovery": {
    "crawl_enabled": true,
    "max_depth": 3
  },
  "limits": {
    "allowed_methods": ["GET", "POST", "PUT", "DELETE", "PATCH"]
  },
  "validation": {
    "command": ["npm", "test"],
    "working_dir": "/target",
    "timeout": 300
  },
  "audit": {
    "source_path": "/target",
    "tools": ["npm-audit", "semgrep"],
    "timeout_seconds": 300
  }
}
