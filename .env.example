# ================================================================
# DefendForge — Blue Agent  (.env.example)
# Copy to .env and fill in real values.
# ================================================================

# ---- Environment --------------------------------------------------
ENVIRONMENT=development
DEBUG=true
ROUND_NUMBER=0
# Host port mapping for Blue Agent API & Dashboard (change if 8000 is in use, e.g. 8002)
BLUE_AGENT_PORT=8000

# ---- PostgreSQL ---------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bluememory

# ---- LLM ---------------------------------------------------------
# Primary: Gemini 3.8 Flash (set GEMINI_API_KEY to enable)
# Fallback: Ollama (local) or OpenAI
GEMINI_API_KEY=AIza-REPLACE_ME
GEMINI_MODEL=gemini-3.8-flash
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.15
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=90

# ---- RAG ----------------------------------------------------------
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_VECTOR_STORE=faiss
RAG_FAISS_INDEX_PATH=./data/faiss_index
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.45

# ---- Detection ----------------------------------------------------
DETECTION_BACKEND=isolation_forest
DETECTION_MODEL_PATH=./models/isolation_forest.joblib
DETECTION_ANOMALY_THRESHOLD=0.5
DETECTION_WINDOW_SECONDS=60
DETECTION_MIN_EVENTS=3

# ---- PPO ----------------------------------------------------------
PPO_MODEL_PATH=./models/ppo_policy
PPO_CONFIDENCE_THRESHOLD=0.80
PPO_LEARNING_RATE=0.0003
PPO_GAMMA=0.99
PPO_N_STEPS=2048
PPO_BATCH_SIZE=64
PPO_N_EPOCHS=10
PPO_TOTAL_TIMESTEPS=100000

# ---- Audit --------------------------------------------------------
TARGET_APP_PATH=./target_app
TARGET_APP_URL=http://localhost:5000
SEMGREP_RULES=p/python
BANDIT_CONFIG=
DEPENDENCY_CHECK_PATH=/usr/local/bin/dependency-check

# ---- Validation ---------------------------------------------------
VALIDATION_TEST_DIR=./tests
VALIDATION_TIMEOUT=300
VALIDATION_HEALTH_URL=http://target_app:5000/health
VALIDATION_HEALTH_RETRIES=5
VALIDATION_HEALTH_INTERVAL=3

# ---- Monitoring ---------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=./logs/blue_agent.log
METRICS_EXPORT_INTERVAL=30

# ---- Red Agent auto-start ----------------------------------------
# RED_AUTO_START=true  : Auto-start campaign 30s after Blue Agent is healthy
# RED_AUTO_START=false : Wait for API trigger via dashboard
RED_AUTO_START=false
RED_WARMUP_SECONDS=30
RED_CAMPAIGN_INTERVAL=60
RED_MAX_CAMPAIGNS=0
RED_SIMULATION_ONLY=false
RED_TARGET_URL=http://localhost:5000
RED_REQUEST_TIMEOUT=5
RED_MAX_CAMPAIGN_ROUNDS=5
RED_MAX_CAMPAIGN_EVENTS=25

# ---- Elasticsearch / Kibana ---------------------------------------
ELASTICSEARCH_URL=http://localhost:9200
